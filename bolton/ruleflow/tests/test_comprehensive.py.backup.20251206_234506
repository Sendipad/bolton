        from bolton.ruleflow.methods.deduplication import find_duplicates_by_fields
        
        # Create existing document
        existing = frappe.get_doc({
            "doctype": "ToDo",
            "description": "Duplicate Test Item"
        }).insert(ignore_permissions=True)
        
        # New document with same description
        new_doc = frappe.get_doc({
            "doctype": "ToDo",
            "description": "Duplicate Test Item"
        })
        new_doc.name = "temp-new-doc"  # Fake name for filtering
        
        duplicates = find_duplicates_by_fields(new_doc, {}, fields=["description"])
        
        self.assertIn(existing.name, duplicates)
    
    def test_check_duplicate_and_prevent_save(self):
        """Test duplicate blocking"""
        from bolton.ruleflow.methods.deduplication import check_duplicate_and_prevent_save
        
        # Create existing document
        existing = frappe.get_doc({
            "doctype": "ToDo",
            "description": "Block Duplicate Test"
        }).insert(ignore_permissions=True)
        
        # Try to save duplicate
        new_doc = frappe.get_doc({
            "doctype": "ToDo",
