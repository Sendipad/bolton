class TestScoringEngine(FrappeTestCase):
    """Test ScoringEngine for fuzzy matching"""
    
    def test_exact_scorer(self):
        """Test exact match scoring"""
        from bolton.ruleflow.core.scoring import ScoringEngine
        
        rule = MagicMock()
        rule.options_json = json.dumps({
            "scoring_fields": [{"field": "name", "scorer": "exact", "weight": 1}]
        })
        
        engine = ScoringEngine(rule)
        
        score = engine._score_field("Hello", "Hello", "exact")
        self.assertEqual(score, 1.0)
        
        score = engine._score_field("Hello", "World", "exact")
        self.assertEqual(score, 0.0)
    
    def test_fuzzy_scorer(self):
        """Test fuzzy match scoring"""
        from bolton.ruleflow.core.scoring import ScoringEngine
        
        rule = MagicMock()
        rule.options_json = "{}"
        
        engine = ScoringEngine(rule)
        
        # Similar strings should have high score
        score = engine._score_field("Hello World", "Hello Wrold", "fuzzy")
        self.assertGreater(score, 0.8)
        
        # Different strings should have low score
        score = engine._score_field("Hello", "Goodbye", "fuzzy")
        self.assertLess(score, 0.5)
    
    def test_token_scorer(self):
        """Test token sort ratio scoring"""
        from bolton.ruleflow.core.scoring import ScoringEngine
        
        rule = MagicMock()
        rule.options_json = "{}"
        
        engine = ScoringEngine(rule)
        
        # Token sort should handle word order
        score = engine._score_field("John Smith", "Smith John", "token")
        self.assertEqual(score, 1.0)
    
    def test_fingerprint_creation(self):
        """Test document fingerprinting"""
        from bolton.ruleflow.core.scoring import ScoringEngine
        
        doc = frappe._dict({"name": "Test", "email": "test@example.com"})
        
        fp = ScoringEngine.create_fingerprint(doc, ["name", "email"])
        
        self.assertIsInstance(fp, str)
        self.assertEqual(len(fp), 32)  # MD5 hash length


