class TestRuleEngine(FrappeTestCase):
    """Test RuleEngine class"""
    
    @classmethod
    def setUpClass(cls):
        super().setUpClass()
        frappe.set_user('Administrator')
    
    def test_engine_initialization(self):
        """Test engine initializes correctly"""
        from bolton.ruleflow.core.engine import RuleEngine
        
        rule = create_test_rule("Test Engine Init")
        engine = RuleEngine(rule)
        
        self.assertEqual(engine.rule.name, "Test Engine Init")
        self.assertIsInstance(engine.execution_log, list)
    
    def test_engine_validates_disabled_rule(self):
        """Test engine rejects disabled rules"""
        from bolton.ruleflow.core.engine import RuleEngine
        from bolton.ruleflow.core.exceptions import RuleDisabledError
        
        rule = create_test_rule("Test Disabled Rule")
        rule.is_active = 0
        rule.save()
        
        engine = RuleEngine(rule)
        doc = frappe.get_doc({"doctype": "ToDo", "description": "Test"})
        
        with self.assertRaises(RuleDisabledError):
            engine.execute(doc)
    
    def test_engine_context_initialization(self):
        """Test execution context is properly initialized"""
        from bolton.ruleflow.core.engine import RuleEngine
        
        rule = create_test_rule("Test Context Init", actions=[
            {"action_id": "a1", "action_label": "Process 1", "action_type": "Process", "is_enabled": 1}
        ])
        
        engine = RuleEngine(rule, {'test_mode': True})
        doc = frappe.get_doc({"doctype": "ToDo", "description": "Test"})
        
        context = engine._initialize_context(doc)
        
        self.assertIn('doc', context)
        self.assertIn('vars', context)
        self.assertIn('meta', context)
        self.assertEqual(context['meta']['test_mode'], True)
    
    @classmethod
    def tearDownClass(cls):
        frappe.db.rollback()
        super().tearDownClass()


class TestRuleCoordinator(FrappeTestCase):
    """Test RuleCoordinator class"""
    
    @classmethod
    def setUpClass(cls):
        super().setUpClass()
        frappe.set_user('Administrator')
    
    def test_has_active_rules_caching(self):
        """Test rule existence check uses cache"""
        from bolton.ruleflow.core.coordinator import RuleCoordinator
        
        # Clear cache first
        RuleCoordinator.clear_cache()
        
        # Create rule
        create_test_rule("Test Cache Rule", doctype="ToDo", event="Before Save")
        
        # First call should hit DB
        result1 = RuleCoordinator.has_active_rules("ToDo", "Before Save")
        
        # Second call should hit cache (we can verify by checking it returns same result)
        result2 = RuleCoordinator.has_active_rules("ToDo", "Before Save")
        
        self.assertEqual(result1, result2)
        self.assertTrue(result1)
    
    def test_get_applicable_rules_ordering(self):
        """Test rules are returned in priority order"""
        from bolton.ruleflow.core.coordinator import RuleCoordinator
        
        RuleCoordinator.clear_cache()
        
        # Create rules with different priorities
        rule1 = create_test_rule("Test Priority Low", doctype="ToDo", event="After Save")
        rule1.priority = 10
        rule1.save()
        
        rule2 = create_test_rule("Test Priority High", doctype="ToDo", event="After Save")
        rule2.priority = 100
        rule2.save()
        
        rules = RuleCoordinator.get_applicable_rules("ToDo", "After Save")
        
        # Higher priority should come first
        if len(rules) >= 2:
            self.assertGreaterEqual(rules[0].priority, rules[1].priority)
    
    def test_clear_cache_specific_doctype(self):
        """Test cache clearing for specific doctype"""
        from bolton.ruleflow.core.coordinator import RuleCoordinator
        
        # Should not raise
        RuleCoordinator.clear_cache("ToDo")
        RuleCoordinator.clear_cache()  # Clear all
    
    @classmethod
    def tearDownClass(cls):
        frappe.db.rollback()
        super().tearDownClass()


