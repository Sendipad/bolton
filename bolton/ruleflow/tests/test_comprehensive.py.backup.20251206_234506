class TestValidationMethods(FrappeTestCase):
    """Test validation process methods"""
    
    def test_validate_required_fields_success(self):
        """Test required fields pass when present"""
        from bolton.ruleflow.methods.validation import validate_required_fields
        
        doc = frappe.get_doc({"doctype": "ToDo", "description": "Test"})
        
        result = validate_required_fields(doc, {}, fields=["description"])
        self.assertTrue(result)
    
    def test_validate_required_fields_failure(self):
        """Test required fields fail when missing"""
        from bolton.ruleflow.methods.validation import validate_required_fields
        
        doc = frappe.get_doc({"doctype": "ToDo", "description": ""})
        
        with self.assertRaises(frappe.ValidationError):
            validate_required_fields(doc, {}, fields=["description"])
    
    def test_validate_field_pattern_success(self):
        """Test pattern validation with valid input"""
        from bolton.ruleflow.methods.validation import validate_field_pattern
        
        doc = frappe._dict({"email": "test@example.com"})
        
        result = validate_field_pattern(doc, {}, field="email", pattern=r".*@.*\..*")
        self.assertTrue(result)
    
    def test_validate_field_pattern_empty_passes(self):
        """Test empty values pass pattern validation"""
        from bolton.ruleflow.methods.validation import validate_field_pattern
        
        doc = frappe._dict({"email": ""})
        
        result = validate_field_pattern(doc, {}, field="email", pattern=r".*@.*\..*")
        self.assertTrue(result)
    
    def test_validate_value_in_range(self):
        """Test numeric range validation"""
        from bolton.ruleflow.methods.validation import validate_value_in_range
        
        doc = frappe._dict({"amount": 50})
        
        # Within range
        result = validate_value_in_range(doc, {}, field="amount", min_value=0, max_value=100)
        self.assertTrue(result)
        
        # Below min
        doc.amount = -10
        with self.assertRaises(frappe.ValidationError):
            validate_value_in_range(doc, {}, field="amount", min_value=0)
        
        # Above max
        doc.amount = 200
        with self.assertRaises(frappe.ValidationError):
            validate_value_in_range(doc, {}, field="amount", max_value=100)
    
    def test_validate_conditional_required(self):
        """Test conditional required fields"""
        from bolton.ruleflow.methods.validation import validate_conditional_required
        
        # Condition not met - should pass
        doc = frappe._dict({"status": "Draft", "reason": ""})
        result = validate_conditional_required(
            doc, {},
            condition_field="status",
            condition_value="Cancelled",
            required_fields=["reason"]
        )
        self.assertTrue(result)
        
        # Condition met, field present - should pass
        doc = frappe._dict({"status": "Cancelled", "reason": "No longer needed"})
        result = validate_conditional_required(
            doc, {},
            condition_field="status",
            condition_value="Cancelled",
            required_fields=["reason"]
        )
        self.assertTrue(result)
        
        # Condition met, field missing - should fail
        doc = frappe._dict({"status": "Cancelled", "reason": ""})
        with self.assertRaises(frappe.ValidationError):
            validate_conditional_required(
                doc, {},
                condition_field="status",
                condition_value="Cancelled",
                required_fields=["reason"]
            )


