"""
Deduplication process methods for the Bolton Rule Engine

All methods use the context-first pattern:
    def method_name(context, **kwargs):
        doc = context.get('doc')
        ...
"""

import frappe
from frappe import _


def find_similar_records(context, fields, similarity_threshold=0.8, **kwargs):
	"""
	Find similar records using fuzzy matching
	
	Args:
		context: Execution context containing 'doc'
		fields: List of fields to compare
		similarity_threshold: Minimum similarity score (0-1)
		
	Returns:
		List of similar document names
	"""
	doc = context.get('doc')
	
	try:
		from rapidfuzz import fuzz
	except ImportError:
		frappe.logger().warning("rapidfuzz not installed, using exact matching")
		return find_duplicates_by_fields(context, fields=fields)
	
	# Get all documents to compare
	all_docs = frappe.get_all(
		doc.doctype,
		filters={'name': ['!=', doc.name], 'docstatus': ['!=', 2]},
		fields=['name'] + fields
	)
	
	similar_docs = []
	for other_doc in all_docs:
		# Calculate similarity score across all fields
		scores = []
		for field in fields:
			value1 = str(doc.get(field) or '').lower()
			value2 = str(other_doc.get(field) or '').lower()
			
			if value1 and value2:
				score = fuzz.ratio(value1, value2) / 100.0
				scores.append(score)
		
		if scores:
			avg_score = sum(scores) / len(scores)
			if avg_score >= similarity_threshold:
				similar_docs.append({
					'name': other_doc.name,
					'similarity': avg_score
				})
	
	return similar_docs


def find_duplicates_by_fields(context, fields, ignore_cancelled=True, **kwargs):
	"""
	Find exact duplicate records based on field values
	
	Args:
		context: Execution context containing 'doc'
		fields: List of fields to check for duplicates
		ignore_cancelled: Whether to ignore cancelled documents
		
	Returns:
		List of duplicate document names
	"""
	doc = context.get('doc')
	
	# Build filters
	filters = {}
	for field in fields:
		value = doc.get(field)
		if value:
			filters[field] = value
	
	if not filters:
		return []
	
	# Exclude current document
	filters['name'] = ['!=', doc.name]
	
	if ignore_cancelled:
		filters['docstatus'] = ['!=', 2]
	
	# Find duplicates
	duplicates = frappe.get_all(
		doc.doctype,
		filters=filters,
		fields=['name']
	)
	
	return [d.name for d in duplicates]


def check_duplicate_and_prevent_save(context, fields, **kwargs):
	"""
	Check for duplicates and prevent save if found
	
	Args:
		context: Execution context containing 'doc'
		fields: List of fields to check
		
	Returns:
		Boolean: False always (throws error if duplicates found)
	"""
	doc = context.get('doc')
	duplicates = find_duplicates_by_fields(context, fields=fields)
	
	if duplicates:
		field_labels = [frappe.get_meta(doc.doctype).get_label(f) for f in fields]
		frappe.throw(
			_("Duplicate record found based on: {0}. Existing records: {1}").format(
				", ".join(field_labels),
				", ".join(duplicates)
			),
			frappe.DuplicateEntryError
		)
	
	return False


def mark_as_duplicate(context, master_document, **kwargs):
	"""
	Mark document as duplicate of another document
	
	Args:
		context: Execution context containing 'doc'
		master_document: Name of the master/original document
		
	Returns:
		Name of master document
	"""
	doc = context.get('doc')
	
	# Check if document has a 'is_duplicate' or similar field
	meta = frappe.get_meta(doc.doctype)
	
	if meta.has_field('is_duplicate'):
		doc.is_duplicate = 1
	
	if meta.has_field('duplicate_of'):
		doc.duplicate_of = master_document
	
	# Create a comment noting the duplicate
	frappe.get_doc({
		'doctype': 'Comment',
		'comment_type': 'Info',
		'reference_doctype': doc.doctype,
		'reference_name': doc.name,
		'content': f'Marked as duplicate of {master_document}'
	}).insert(ignore_permissions=True)
	
	return master_document


def merge_with_duplicate(context, master_document_name, **kwargs):
	"""
	Merge this document with another document
	
	Args:
		context: Execution context containing 'doc'
		master_document_name: Name of document to merge into
		
	Returns:
		Name of master document after merge
	"""
	doc = context.get('doc')
	
	try:
		# Use Frappe's merge functionality
		from frappe.model.rename_doc import merge_docs
		
		merge_docs(
			doc.doctype,
			master_document_name,
			doc.name
		)
		
		return master_document_name
	except Exception as e:
		frappe.logger().error(f"Merge failed: {str(e)}")
		raise

